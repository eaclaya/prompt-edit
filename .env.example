# Docker (docs/PLAN.md §0). Each worktree uses its own project name and ports:
# S<N> → COMPOSE_PROJECT_NAME=prompt-edit-s<N>, APP_PORT=800<N>, FORWARD_DB_PORT=540<N>,
#        FORWARD_REDIS_PORT=630<N>, VITE_PORT=520<N>, FORWARD_MAILPIT_DASHBOARD_PORT=802<N>
COMPOSE_PROJECT_NAME=prompt-edit
APP_PORT=8000
FORWARD_DB_PORT=5432
FORWARD_REDIS_PORT=6379
VITE_PORT=5173
FORWARD_MAILPIT_DASHBOARD_PORT=8025
WWWUSER=1000
WWWGROUP=1000

# Cloudflare named tunnel serving https://prompt-edit.hondukash.dev (never commit the token)
CLOUDFLARE_TUNNEL_TOKEN=

APP_NAME="Pixelforge Studio"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# When tunnelling: APP_URL=https://prompt-edit.hondukash.dev
APP_URL=http://localhost:${APP_PORT}

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=laravel
DB_USERNAME=sail
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Pixelforge (https://pixelforge.promptedit.dev/docs)
PIXELFORGE_BASE_URL=https://pixelforge.promptedit.dev/v1
PIXELFORGE_API_KEY=
PIXELFORGE_WEBHOOK_SECRET=
PIXELFORGE_WEBHOOK_TOLERANCE=300
PIXELFORGE_TIMEOUT=10
PIXELFORGE_CONNECT_TIMEOUT=5
PIXELFORGE_REQUESTS_PER_MINUTE=60
PIXELFORGE_MAX_CONCURRENT=3

# Billing: markup in basis points (2500 = 25%), welcome credit as a decimal USD string
MARKUP_BPS=2500
WELCOME_CREDIT_USD=1.00
